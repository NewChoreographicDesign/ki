# Database
# Local development (SQLite, already configured in prisma/schema.prisma):
DATABASE_URL="file:./dev.db"
# Production (Neon.tech or Vercel Postgres) — switch provider to "postgresql" in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth
# Long random string, minimum 32 characters
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Email — two options, pick ONE:
#
# Option A: Resend (needs a verified domain to send to arbitrary recipients —
# without one, Resend only delivers to the address you signed up with).
RESEND_API_KEY=""
#
# Option B: SMTP via an existing mailbox (e.g. Gmail with an "App Password" —
# no domain/DNS access needed at all). If set, this takes priority over
# Resend. For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=your-address@gmail.com, SMTP_PASSWORD=the 16-character app
# password from https://myaccount.google.com/apppasswords (requires
# 2-Step Verification to be enabled on that Google account first).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
#
# Used by both options as the sender shown to recipients. With SMTP this
# should generally use the same address as SMTP_USER.
EMAIL_FROM="Woongroep Admin <noreply@example.com>"

# Settings defaults (also editable in Backend > Instellingen after seeding)
GENERAL_EMAIL="algemeen@example.com"
COORDINATOR_EMAIL="coordinator@example.com"

# Cron
# Shared secret required as `Authorization: Bearer <CRON_SECRET>` header on /api/cron/* routes
CRON_SECRET="change-me-cron-secret"

# Cloudinary (optional, for documents/protocols uploads) — free account at
# https://cloudinary.com. Pick ONE of the two options below; if CLOUDINARY_URL
# is set, it takes priority.
#
# Option A: the single combined string Cloudinary's dashboard shows by
# default (cloudinary://<api_key>:<api_secret>@<cloud_name>) — copy it as-is.
CLOUDINARY_URL=""
#
# Option B: the same three values, split out — also on your Cloudinary
# dashboard's front page ("Product Environment Credentials").
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
