# Database
# Local development (SQLite, already configured in prisma/schema.prisma):
DATABASE_URL="file:./dev.db"
# Production (Neon.tech or Vercel Postgres) — switch provider to "postgresql" in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth
# Long random string, minimum 32 characters
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Cron
# Shared secret required as `Authorization: Bearer <CRON_SECRET>` header on /api/cron/* routes
CRON_SECRET="change-me-cron-secret"

# Structured logging (optional) — JSON lines to stdout/stderr, which
# Vercel forwards to any configured Log Drain with zero extra setup here.
# trace/debug/info/warning/error/fatal — "security" events (logins, MFA,
# ...) are always emitted regardless of this setting. Default: info.
LOG_LEVEL="info"
# Direct SIEM sinks (optional, off by default) — for when Vercel's own Log
# Drains aren't used and a customer's SOC needs a direct push instead. See
# lib/log-drain.ts. Set ONE of these two blocks, or neither.
SIEM_WEBHOOK_URL=""
SIEM_WEBHOOK_HEADER="Authorization"
SIEM_WEBHOOK_HEADER_PREFIX="Bearer "
SIEM_WEBHOOK_TOKEN=""
SIEM_SYSLOG_HOST=""
SIEM_SYSLOG_PORT="601"
SIEM_SYSLOG_PROTOCOL="tcp"
SIEM_SYSLOG_TLS="false"
SIEM_SYSLOG_FACILITY="16"
SIEM_SYSLOG_ENTERPRISE_ID=""

# Device restriction (optional) — restricts the ENTIRE app (including
# /login) to devices that have entered DEVICE_PASSCODE once at /apparaat.
# Replaces an earlier IP-based "network restriction": IP allowlisting turned
# out to be unreliable wherever the office connection's public IP changes
# (common on consumer/small-business internet), which locked staff out
# entirely. This is deliberately controlled ONLY via these env vars, not an
# in-app toggle — a toggle that can block the whole app (including the
# settings page you'd use to undo it) is a lockout waiting to happen, which
# is exactly what happened before. Recovery only ever needs Vercel dashboard
# access (flip DEVICE_RESTRICTION_ENABLED back to false, redeploy), same as
# a JWT_SECRET/CRON_SECRET problem.
# Leave both unset/false to leave the app unrestricted (default).
DEVICE_RESTRICTION_ENABLED="false"
# Pick a long, hard-to-guess value (not a 4-digit PIN) — 10 wrong guesses in
# a row locks out ALL unlock attempts for 15 minutes (a global throttle, not
# per-device, since this one secret is shared by everyone), but that's a
# backstop, not a substitute for a real secret. Rotating this value
# immediately invalidates every already-unlocked device at once — the way to
# "kick everyone off" if a device is lost or someone should no longer have it.
DEVICE_PASSCODE=""

# Cloudinary (optional, for protocollen uploads) — free account at
# https://cloudinary.com. Pick ONE of the two options below; if CLOUDINARY_URL
# is set, it takes priority.
#
# Option A: the single combined string Cloudinary's dashboard shows by
# default (cloudinary://<api_key>:<api_secret>@<cloud_name>) — copy it as-is.
CLOUDINARY_URL=""
#
# Option B: the same three values, split out — also on your Cloudinary
# dashboard's front page ("Product Environment Credentials").
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Microsoft sign-in (optional) — "Inloggen met Microsoft" on /login, as an
# alternative to naam+geboortedatum. Uses ONE Azure app registration you
# own (Azure Portal -> App registrations -> New registration), configured
# as multitenant ("Accounts in any organizational directory") and pointed
# at this deployment's own /api/auth/sso/microsoft/callback as a redirect
# URI — no per-customer Azure tenant setup needed. Access control is NOT
# "which company issued the token": any work/school Microsoft account can
# complete sign-in, but only actually logs in if its email matches an
# existing, active, non-invaller User (set via Medewerkers). Leave both
# unset to hide the "Inloggen met Microsoft" button entirely.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Web Push (optional) — lets admins get an instant push notification the
# moment a rapportage is submitted (see lib/push.ts), and any user opt in
# to notifications from Instellingen. Generate a VAPID key pair once with
# `npx web-push generate-vapid-keys` and paste both values below; leave
# unset to disable push entirely (the app works fine without it, reports
# just aren't pushed).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Shown to Microsoft/Apple's push services as the sender's contact — any
# mailto: address works, doesn't need to be a real inbox.
VAPID_SUBJECT="mailto:admin@example.com"
