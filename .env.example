# Database
# Local development (SQLite, already configured in prisma/schema.prisma):
DATABASE_URL="file:./dev.db"
# Production (Neon.tech or Vercel Postgres) — switch provider to "postgresql" in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth
# Long random string, minimum 32 characters
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Cron
# Shared secret required as `Authorization: Bearer <CRON_SECRET>` header on /api/cron/* routes
CRON_SECRET="change-me-cron-secret"

# Network restriction (optional) — emergency-unlock secret. Only needed if
# you plan to turn on "Netwerkbeveiliging" in Backend > Instellingen, which
# restricts the whole app to a configured IP allowlist. Set this to a long
# random string BEFORE enabling that toggle: if you ever get locked out
# (wrong/changed IP), visit https://your-app-url/login?bypass=<this value>
# from any network to regain access. Leave unset if you never plan to use
# network restriction — the toggle then simply has no unlock mechanism.
NETWORK_BYPASS_SECRET=""

# Cloudinary (optional, for documents/protocols uploads) — free account at
# https://cloudinary.com. Pick ONE of the two options below; if CLOUDINARY_URL
# is set, it takes priority.
#
# Option A: the single combined string Cloudinary's dashboard shows by
# default (cloudinary://<api_key>:<api_secret>@<cloud_name>) — copy it as-is.
CLOUDINARY_URL=""
#
# Option B: the same three values, split out — also on your Cloudinary
# dashboard's front page ("Product Environment Credentials").
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
