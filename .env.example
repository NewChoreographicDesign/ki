# Database
# Local development (SQLite, already configured in prisma/schema.prisma):
DATABASE_URL="file:./dev.db"
# Production (Neon.tech or Vercel Postgres) — switch provider to "postgresql" in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth
# Long random string, minimum 32 characters
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Cron
# Shared secret required as `Authorization: Bearer <CRON_SECRET>` header on /api/cron/* routes
CRON_SECRET="change-me-cron-secret"

# Device restriction (optional) — restricts the ENTIRE app (including
# /login) to devices that have entered DEVICE_PASSCODE once at /apparaat.
# Replaces an earlier IP-based "network restriction": IP allowlisting turned
# out to be unreliable wherever the office connection's public IP changes
# (common on consumer/small-business internet), which locked staff out
# entirely. This is deliberately controlled ONLY via these env vars, not an
# in-app toggle — a toggle that can block the whole app (including the
# settings page you'd use to undo it) is a lockout waiting to happen, which
# is exactly what happened before. Recovery only ever needs Vercel dashboard
# access (flip DEVICE_RESTRICTION_ENABLED back to false, redeploy), same as
# a JWT_SECRET/CRON_SECRET problem.
# Leave both unset/false to leave the app unrestricted (default).
DEVICE_RESTRICTION_ENABLED="false"
# Pick a long, hard-to-guess value (not a 4-digit PIN) — there is no lockout
# on wrong attempts, same reasoning as JWT_SECRET/CRON_SECRET. Rotating this
# value immediately invalidates every already-unlocked device at once — the
# way to "kick everyone off" if a device is lost or someone should no longer
# have it.
DEVICE_PASSCODE=""

# Cloudinary (optional, for protocollen uploads) — free account at
# https://cloudinary.com. Pick ONE of the two options below; if CLOUDINARY_URL
# is set, it takes priority.
#
# Option A: the single combined string Cloudinary's dashboard shows by
# default (cloudinary://<api_key>:<api_secret>@<cloud_name>) — copy it as-is.
CLOUDINARY_URL=""
#
# Option B: the same three values, split out — also on your Cloudinary
# dashboard's front page ("Product Environment Credentials").
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
