generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// The Vercel build automatically switches this to "postgresql" when
// DATABASE_URL points at a Postgres database — see scripts/prepare-datasource.js.
// For local development this stays "sqlite"; no manual edit needed.

enum Role {
  ADMIN
  COORDINATOR
  EMPLOYEE
  // Self-registered flexwerker (uitzendkracht) — see InvallerRegistration
  // and app/invaller-registratie. Deliberately excluded from Backend, MFA
  // enforcement, and SSO matching: an invaller's access is already the
  // minimal "log a shift, write a report" set, and their account isn't
  // provisioned by an admin the way vast personeel's is.
  INVALLER
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
}

// Open vs AFGEROND (finished) — see the Intervention model comment for why
// there's no third state and no delete path.
enum InterventionStatus {
  OPEN
  AFGEROND
}

model User {
  id        String    @id @default(cuid())
  name      String    @unique
  birthDate DateTime
  role      Role      @default(EMPLOYEE)
  active    Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // Not a login credential (login stays name+birthdate) — used to deliver
  // push notifications AND, for vast personeel, as the matching key
  // Microsoft SSO links an Azure identity to on first login (see
  // lib/microsoft-sso.ts and app/api/auth/sso/microsoft/callback).
  // Settable two ways: self-service (app/api/account/email/route.ts) or
  // by an admin at creation/afterwards (app/api/backend/users). A plain
  // DB-level unique constraint is enough here (unlike the multi-tenant
  // Multi-Woongroep sibling of this app, which has to check uniqueness
  // across every group in an organisation instead) — this app has exactly
  // one tenant.
  email               String?   @unique
  // Set once an Azure AD identity has been linked via Microsoft SSO — the
  // fast-path match on every subsequent login, so a later email change
  // never breaks an already-linked account.
  azureObjectId       String?   @unique
  mfaEnabled          Boolean   @default(false)
  mfaSecretEncrypted  String?
  mfaEnrolledAt       DateTime?
  // Invaller-only: which uitzendbureau (staffing agency) this flexwerker
  // is from, captured at self-registration. Null for every other role.
  uitzendbureau       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  reports          Report[]
  medicationChecks MedicationCheck[]
  presences        Presence[]
  handovers        Handover[]
  todosCreated     Todo[]             @relation("TodoCreatedBy")
  todosCompleted   Todo[]             @relation("TodoCompletedBy")
  todosAssigned    Todo[]             @relation("TodoAssignedTo")
  appointments     Appointment[]
  shifts           Shift[]
  weekPlans        WeekPlan[]
  documents        Document[]
  auditLogs        AuditLog[]
  interventionsCreated Intervention[]     @relation("InterventionCreatedBy")
  interventionsClosed  Intervention[]     @relation("InterventionClosedBy")
  interventionNotes    InterventionNote[]
  mfaBackupCodes       MfaBackupCode[]
  pushSubscriptions    PushSubscription[]
  dataBreachesReported DataBreachIncident[] @relation("DataBreachReportedBy")
  dataBreachNotes      DataBreachNote[]

  @@index([role])
}

// Recovery codes for TOTP MFA (lib/mfa.ts) — the plaintext is shown once
// at enrollment and never stored, only a salted hash (same scrypt
// primitive as every other credential-shaped secret in this app, see
// lib/passcode.ts), so a database leak alone can never be used to log in.
model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  codeSalt  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A registered Web Push endpoint for one user's one device/browser — see
// lib/push.ts. A user can have several (phone + desktop), each notified
// independently; a dead/unsubscribed endpoint is pruned automatically
// when Web Push reports it gone (410/404), not left to accumulate.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// The app's one reusable invaller self-registration code — see
// app/invaller-registratie and app/api/auth/invaller-register. A
// singleton row (same "one fixed id" pattern as DeviceUnlockLockout
// above): this app has exactly one tenant, so there is exactly one code,
// not one per group like the multi-tenant Multi-Woongroep sibling.
model InvallerRegistration {
  id            String   @id @default("singleton")
  enabled       Boolean  @default(false)
  codeHash      String?
  codeSalt      String?
  // Recoverable copy for the admin-facing "show me the current code"
  // reveal on Medewerkers, alongside the one-way codeHash used to
  // actually verify a registration attempt — see lib/passcode.ts.
  codeEncrypted String?
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt
}

model Client {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  room        String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents    Document[]
  protocols    Protocol[]
  reports      Report[]
  medications  Medication[]
  weekPlans    WeekPlan[]
  presences    Presence[]
  appointments Appointment[]
  handovers    Handover[]
  interventions Intervention[]

  @@index([active])
}

enum DocumentCategory {
  GENERAL
  ONBOARDING
}

// The Documenten feature (upload/view) was removed from the app. This model
// is kept, unused, rather than dropped: deleting it would make `prisma db
// push` refuse the next deploy as a destructive change (or silently drop
// any documents already stored for a live installation) — see README.md.
model Document {
  id           String           @id @default(cuid())
  title        String
  url          String
  clientId     String?
  client       Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Only meaningful when clientId is null — separates the "Algemeen" and
  // "Nieuwe medewerker" threads. A client document belongs to the client's
  // own thread regardless of this value.
  category     DocumentCategory @default(GENERAL)
  uploadedById String
  uploadedBy   User             @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())

  @@index([clientId])
}

model Protocol {
  id        String   @id @default(cuid())
  title     String
  // Either typed text, an uploaded file's URL, or both — see protocolSchema
  // in lib/validations.ts, which requires at least one.
  content   String?
  url       String?
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model Report {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift     ShiftType
  date      DateTime
  content   String
  createdAt DateTime  @default(now())

  @@index([clientId, date])
  @@index([userId])
}

model Medication {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  dosage        String
  instructions  String?
  // Comma-separated "HH:MM" schedule, e.g. "08:00,20:00" — empty when
  // asNeeded is true (no fixed schedule, so nothing to parse).
  times         String
  // "Indien nodig" (PRN): given only when the client needs it, not on a
  // fixed schedule. No scheduled times means no reminder banner (see
  // lib/medication-reminders.ts) and no daily slot cap on registrations
  // (see app/api/medication-checks/route.ts) — it can be logged any number
  // of times a day.
  asNeeded      Boolean  @default(false)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  checks MedicationCheck[]

  @@index([clientId, active])
}

enum MedicationCheckStatus {
  TAKEN // Afgevinkt: ingenomen zoals voorgeschreven.
  LEAVE // Verlof: cliënt afwezig, geen inname aan de orde.
  NOT_TAKEN // Niet ingenomen: aanwezig maar bewust/onbewust niet ingenomen.
}

// Irreversible audit log: no update/delete allowed at the API layer.
model MedicationCheck {
  id           String                @id @default(cuid())
  medicationId String
  medication   Medication            @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       MedicationCheckStatus @default(TAKEN)
  comment      String?
  checkedAt    DateTime              @default(now())

  @@index([medicationId, checkedAt])
  @@index([userId])
}

model WeekPlan {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  dayOfWeek Int // 0 = Monday .. 6 = Sunday
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  activity  String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, dayOfWeek])
}

model Todo {
  id              String    @id @default(cuid())
  title           String
  description     String?
  priority        Priority  @default(MEDIUM)
  // Deprecated, unused — superseded by daysOfWeek below. Kept (rather than
  // dropped) so `prisma db push` stays a purely additive change against the
  // already-deployed schema; dropping a populated column is treated as data
  // loss and `db push` refuses to run non-interactively without a flag we
  // deliberately never pass (see the "Terugkerende to-do's" README section).
  dayOfWeek       Int?
  // Comma-separated weekday indices this task applies to, e.g. "0,2,4" for
  // Ma/Wo/Vr, or "0,1,2,3,4,5,6" for every day. Empty string = no specific
  // day. Same 0=Monday..6=Sunday convention as WeekPlan.dayOfWeek. Stored as
  // a string rather than a native array so this keeps working on SQLite in
  // local dev, not just Postgres (see scripts/prepare-datasource.js).
  daysOfWeek      String    @default("")
  // Scheduled time of day, "HH:MM" (Europe/Amsterdam). Optional — not every
  // task needs a specific time. Drives the sort order on the Todos page and
  // the "due soon" list, same string-not-Date choice as Medication.times.
  time            String?
  // A recurring task gets automatically reopened as a fresh copy the next
  // time one of its daysOfWeek comes around, once the current one has been
  // completed — see regenerateRecurringTodos() in lib/recurring-todos.ts.
  recurring       Boolean   @default(false)
  // Set once this completed recurring task has spawned its next occurrence,
  // so a task is never regenerated twice for the same completion.
  regenerated     Boolean   @default(false)
  completed       Boolean   @default(false)
  completedById   String?
  completedBy     User?     @relation("TodoCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt     DateTime?
  completionNote  String?
  createdById     String
  createdBy       User      @relation("TodoCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  // Personal to-do's: set when this task is assigned to one specific
  // medewerker (by themselves, or by an admin/coordinator via Backend)
  // rather than shared on the team-wide Werklijst. Null = shared task,
  // unchanged from all existing behavior. See app/(app)/todos/page.tsx,
  // which filters this to null for the shared list.
  assignedToId    String?
  assignedTo      User?     @relation("TodoAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  // Optional room tag for a personal to-do — null/empty means "Algemeen",
  // same free-text convention as Client.room.
  room            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([completed, priority])
  @@index([recurring, completed, regenerated])
  @@index([assignedToId, completed])
}

model Presence {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  present   Boolean
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, date])
  @@index([date])
}

// Handover notes are written per room (client) — or with clientId left empty
// for a general, not-room-specific note — and auto-expire 7 days after
// creation (see app/api/handovers/route.ts). An admin can also delete one
// outright before that.
model Handover {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  shift     ShiftType
  content   String
  createdAt DateTime  @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@index([clientId])
}

// A tracked intervention for one client — distinct from a Handover note:
// a handover is a transient "what should the next shift know" message that
// auto-expires in 7 days, while an intervention is a standing record of
// something that happened and needs follow-through (a behavioural incident,
// a care-plan adjustment, anything that isn't resolved in one shift). Shown
// on the Overdracht screen — see app/(app)/overdracht — visible to every
// role (Employee/Coordinator/Admin alike, same as Handover), since anyone
// on shift needs to know what's still open for a client.
//
// Deliberately no DELETE route: an open intervention is never removed —
// only ever closed (status -> AFGEROND) once it's actually resolved, so
// the record of what was done and why is permanent, same spirit as
// MedicationCheck's "irreversible audit log" comment.
model Intervention {
  id          String             @id @default(cuid())
  clientId    String
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // What happened — the event or situation that prompted this intervention.
  description String
  // What this intervention is meant to achieve.
  goal        String
  // What has already been done about it, as of creation.
  stepsTaken  String
  // What still needs to happen — the reason this starts as OPEN rather
  // than being logged as already resolved.
  followUpNeeded String
  status      InterventionStatus @default(OPEN)
  createdById String
  createdBy   User               @relation("InterventionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  closedAt    DateTime?
  closedById  String?
  closedBy    User?              @relation("InterventionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  notes InterventionNote[]

  @@index([clientId])
  @@index([status])
}

// One chronological follow-up entry on an Intervention — "what we did
// since", written by anyone who can see the intervention. Never edited or
// deleted once posted, same append-only timeline pattern as Handover.
model InterventionNote {
  id             String       @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())

  @@index([interventionId, createdAt])
}

model Appointment {
  id            String   @id @default(cuid())
  title         String
  description   String?
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  startAt       DateTime
  reminderSent  Boolean  @default(false)
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([startAt])
  @@index([reminderSent, startAt])
}

// Auto-started on login (morning 07:00-15:00 / evening 14:00-23:00 window).
model Shift {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ShiftType
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([userId, startedAt])
}

// Single source of truth for app-wide config (organization name, etc).
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Brute-force throttle for /api/device/unlock (see lib/device-lockout.ts).
// A single fixed-id row: DEVICE_PASSCODE is one global shared secret, not a
// per-user credential, so there is exactly one counter, not a table keyed by
// account. Kept out of Setting on purpose — that table is rendered wholesale
// on the instellingen page, and this is bookkeeping, not organization config.
model DeviceUnlockLockout {
  id          String    @id @default("singleton")
  attempts    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// Accountability trail for sensitive actions (AVG Art. 5(2)). Deliberately
// scoped to writes/logins, not every page view — logging every read would
// add a DB write to every request for comparatively little investigative
// value. userId is nullable because a failed-login attempt (wrong name) may
// not resolve to a real user, and SetOnDelete keeps history after a user is
// removed.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

enum AuditFindingSeverity {
  LOW
  MEDIUM
  HIGH
}

// One row per execution of the periodic AuditLog review (see
// lib/audit-review.ts, run daily by app/api/cron/audit-review/route.ts) —
// created EVERY run, whether or not it found anything, so this table is
// itself the demonstrable evidence that log review is a regular, ongoing
// process rather than something only done reactively after a complaint.
// findingsCount is a denormalized count of that run's AuditReviewFinding
// rows, kept here so the review-history list doesn't need a join to show it.
model AuditReviewRun {
  id            String   @id @default(cuid())
  windowStart   DateTime
  windowEnd     DateTime
  findingsCount Int      @default(0)
  createdAt     DateTime @default(now())

  findings AuditReviewFinding[]

  @@index([createdAt])
}

// One flagged anomaly from a single AuditReviewRun — e.g. an unusual burst
// of failed logins, or a spike in 401/403 responses. `resolved` turns the
// automated flag into an actual "controle" event: an admin reading and
// acknowledging it, not just the system noticing it.
model AuditReviewFinding {
  id               String               @id @default(cuid())
  runId            String
  run              AuditReviewRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  category         String
  severity         AuditFindingSeverity
  summary          String
  resolved         Boolean              @default(false)
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime             @default(now())

  @@index([resolved, createdAt])
  @@index([runId])
}

enum DataBreachSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// The AVG Art. 33/34 workflow status — deliberately linear (no going back
// a step once notified), since "we already told the AP" or "we already
// told the data subjects" isn't something the app should let anyone
// un-happen.
enum DataBreachStatus {
  NEW
  ASSESSED
  AP_NOTIFIED
  DATA_SUBJECTS_NOTIFIED
  CLOSED
}

// A reported datalek (data breach) — any team member can report one (see
// app/api/datalek/route.ts, same broad-reporting-audience reasoning as
// every other "whoever notices should be able to report immediately"
// module in this app), an ADMIN triages and carries it through the AVG
// timeline. detectedAt (not createdAt) is what the legally significant
// 72-hour Autoriteit Persoonsgegevens notification clock runs from — see
// lib/data-breach.ts#dataBreachDeadline — since a breach is often
// discovered some time after it actually happened.
model DataBreachIncident {
  id                     String             @id @default(cuid())
  reportedByUserId       String
  reportedBy             User               @relation("DataBreachReportedBy", fields: [reportedByUserId], references: [id], onDelete: Cascade)
  title                  String
  description            String
  // Free-text summary of which data types/how many people are affected —
  // deliberately not a structured client link: a datalek is very often
  // NOT about one specific client record (a lost device, a misdirected
  // email naming several clients), so forcing a single Client relation
  // would misrepresent most real cases.
  affectedData           String
  affectedPersonsEstimate Int?
  // Whether a risk to data subjects' rights/freedoms is judged unlikely
  // (AVG Art. 33(1) exception to the 72-hour AP notification duty) — null
  // until an admin has actually assessed it (status ASSESSED or later).
  likelyRisk             Boolean?
  severity               DataBreachSeverity @default(MEDIUM)
  status                 DataBreachStatus   @default(NEW)
  detectedAt             DateTime
  apNotifiedAt           DateTime?
  apReference            String?
  dataSubjectsNotifiedAt DateTime?
  closedAt               DateTime?
  closedSummary          String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  notes DataBreachNote[]

  @@index([status, createdAt])
  @@index([detectedAt])
}

// Append-only timeline entry on a DataBreachIncident — several people work
// the same case, a note must never silently change under someone who
// already read it.
model DataBreachNote {
  id         String             @id @default(cuid())
  incidentId String
  incident   DataBreachIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId   String
  author     User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime           @default(now())

  @@index([incidentId, createdAt])
}

// One row per completed ISO calendar week, generated automatically by
// /api/cron/weekly-report (see that route for the generation + 1-year
// rolling-retention logic). The PDF itself is stored inline (Bytes) rather
// than in external storage — these are small, infrequent (~52/year), and
// keeping them in the same database avoids depending on Cloudinary being
// configured for a compliance-relevant record.
model WeeklyReportPdf {
  id        String   @id @default(cuid())
  isoYear   Int
  isoWeek   Int
  weekStart DateTime
  pdf       Bytes
  createdAt DateTime @default(now())

  @@unique([isoYear, isoWeek])
  @@index([weekStart])
}
